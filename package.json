{
    "name": "sync-engine",
    "private": true,
    "version": "0.1.0",
    "description": "An offline-capable sync engine for a small issue tracker: Postgres sync log, LISTEN/NOTIFY fan-out, MobX object pool with optimistic transactions.",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
        "dev:server": "tsx watch src/server/main.ts",
        "dev:web": "vite",
        "start": "tsx src/server/main.ts",
        "build": "vite build",
        "db:migrate": "tsx scripts/migrate.ts",
        "db:seed": "tsx scripts/seed.ts",
        "typecheck": "tsc -p tsconfig.json",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "e2e": "playwright test",
        "bench": "NODE_ENV=production tsx bench/sync.ts",
        "bench:web": "tsx bench/web.ts"
    },
    "dependencies": {
        "graphql": "^17.0.2",
        "graphql-yoga": "^5.24.1",
        "idb": "^8.0.3",
        "mobx": "^7.0.6",
        "mobx-react-lite": "^5.1.0",
        "pg": "^8.23.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "ws": "^8.22.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@types/node": "^22.20.5",
        "@types/pg": "^8.23.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/ws": "^8.18.2",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^10.0.5",
        "eslint": "^10.12.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "fake-indexeddb": "^6.2.5",
        "globals": "^17.13.0",
        "playwright-core": "^1.63.0",
        "tsx": "^4.23.15",
        "typescript": "~5.9",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.2",
        "vitest": "^5.0.3"
    }
}
